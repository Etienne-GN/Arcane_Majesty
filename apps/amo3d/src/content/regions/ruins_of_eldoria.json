  "signs": [
    {
      "x": 3,
      "z": 50,
      "text": "The runes on the gate are dead \u2014 not broken, not worn: silenced, as if someone had told them to stop. The air here holds no sound for long."
    },
    {
      "x": 3,
      "z": -36,
      "text": "An empty pedestal at the bottom of the steps. The stone still remembers a light; it is cold to the touch, and yet it hums."
    }
