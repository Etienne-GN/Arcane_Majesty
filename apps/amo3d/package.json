{
  "name": "amo3d-poc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Side proof-of-concept: a 3D character moving with amo's own movement rules.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android": "vite build && cap sync android && cd android && ANDROID_HOME=${ANDROID_HOME:-/opt/android-sdk} ./gradlew assembleDebug -q",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "server": "node server/index.js"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "vite": "^6.0.0"
  }
}
