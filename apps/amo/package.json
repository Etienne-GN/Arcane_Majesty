{
  "name": "arcane-majesty-online",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node tools/validate_catalogue.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "test": "node tools/test_anim_resolve.mjs && node tools/validate_catalogue.mjs && node tools/test_input_bus.mjs && node tools/test_launcher_controls.mjs && node tools/sprite_catalogue/test_validate_sprite_catalogue.mjs && python3 tools/sprite_catalogue/test_crop_check.py",
    "test:anim": "node tools/test_anim_resolve.mjs",
    "test:sprite-catalogue": "node tools/sprite_catalogue/test_validate_sprite_catalogue.mjs",
    "test:crop-check": "python3 tools/sprite_catalogue/test_crop_check.py",
    "gen:anims": "node tools/annotate_anims.js",
    "mobile:sync": "cap sync android",
    "serve:game": "VITE_AMO_CONTROLS=launcher vite preview --host --port 5174",
    "mobile:apk": "cd android && ./gradlew assembleDebug",
    "mobile:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "test:catalogue": "node tools/validate_catalogue.mjs",
    "audit:weapons": "python3 tools/audit_coverage.py",
    "audit:oversize": "python3 tools/audit_oversize.py"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "express": "^4.18.0",
    "phaser": "^3.80.0",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.7.0"
  }
}
